# Copie para .env e preencha com os valores reais (NAO comitar o .env)

# MySQL (host do banco; na Hostinger pode exigir liberar acesso remoto ao IP da VPS)
DB_CONNECTION=Server=SEU_HOST;Port=3306;Database=u224972953_org1;User=SEU_USUARIO;Password=SUA_SENHA;TreatTinyAsBoolean=true

# JWT (minimo 32 caracteres)
JWT_SIGNING_KEY=troque_esta_chave_por_uma_com_no_minimo_32_caracteres

# Senha compartilhada do login (fallback do MVP; usuarios novos usam senha propria)
API_PASSWORD=troque_esta_senha

# Origem do frontend na Hostinger (CORS) - sem barra no final
FRONTEND_ORIGIN=https://seu-dominio.com

# Gemini (Google AI Studio)
GEMINI_API_KEY=sua_chave_gemini

# SMTP (Hostinger: smtp.hostinger.com porta 587)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=sistema@seudominio.com
SMTP_PASSWORD=senha_da_caixa_de_email
SMTP_FROM=sistema@seudominio.com
